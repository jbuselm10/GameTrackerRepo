# GameTracker — Apache rules for GreenGeeks / cPanel shared hosting.
# Password protection: uncomment Auth* lines after creating .htpasswd,
# or use cPanel → Directory Privacy instead.

# --- HTTP Basic Auth (uncomment after .htpasswd exists) ---
# AuthType Basic
# AuthName "Friends and Family Game Tracker"
# Use a full filesystem path from GreenGeeks (cPanel → File Manager →
# show path, or ask support). Example:
# AuthUserFile "/home/YOUR_CPANEL_USER/public_html/.htpasswd"
# Require valid-user

<FilesMatch "^\.htpasswd$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|composer\.phar)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Deny direct web access to Composer vendor tree if present
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^vendor(/|$) - [F,L]
</IfModule>
